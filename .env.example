# Copy to .env (gitignored) and fill in. Empty values mean "not set".
# Never commit real values.

# development | test | production. Production refuses to start unless
# ADMIN_MFA_ENCRYPTION_KEY and CRM_WEBHOOK_SECRET are set and APP_BASE_URL is https.
APP_ENV=development
# Public URL of the frontend; client portal links are built from it. In
# production this is the HTTPS origin that serves the app and /api together.
APP_BASE_URL=http://localhost:5173
# Host names the API answers to, comma-separated. Unset: any host in
# development; in production only APP_BASE_URL's host (wildcards refused).
ALLOWED_HOSTS=
# Built frontend (frontend/dist after `npm run build`) served by the API at /,
# /admin and /portal on the same origin. Unset in development (Vite serves it).
FRONTEND_DIST_DIR=
#
# Not used by this application (do not set): JWT_SECRET, CORS_ORIGINS. Admin
# sessions are opaque server-side tokens in an HttpOnly cookie, and the app and
# API share one origin, so no CORS is configured.

# Local PostgreSQL over the Unix socket with peer authentication: no password
# is stored. For a password-based server use
# postgresql://USER:PASSWORD@HOST:5432/ltd instead; managed providers need
# ?sslmode=require. In production this is the least-privilege ltd_app role
# (deploy/db-roles.sql); migrations run separately as ltd_owner.
DATABASE_URL=postgresql:///ltd
# Tests refuse to run unless this names exactly the database ltd_test.
TEST_DATABASE_URL=postgresql:///ltd_test

# Administrators are individual accounts with mandatory TOTP MFA, created on
# the server with: cd backend && .venv/bin/python -m app.admin_users create ...
# This key encrypts their TOTP secrets at rest (32 random bytes, base64):
#   cd backend && .venv/bin/python -m app.mfa generate-key
# Keep it in the secret manager, separate from database backups. Losing it
# means every administrator must re-enrol MFA (app.admin_users reset-mfa).
ADMIN_MFA_ENCRYPTION_KEY=
# Shared HMAC secret for the CRM webhook (at least 32 characters), e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_WEBHOOK_SECRET=

# Integrations (optional until their tasks are implemented)
# ClickUp: personal API token (Settings > Apps, starts with pk_) of a user who
# can create tasks in the target List, and that List's numeric ID (from the
# List URL .../li/<id> or "Copy link"). Use a dedicated List for testing.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
# IANA zone in which date-only due dates are meant (e.g. Europe/Berlin).
CLICKUP_TIMEZONE=UTC
# Live check only (python -m app.integrations.clickup_live_check): set
# CLICKUP_LIVE_TEST=1 in the shell to allow real writes to the test List.
# Google Sheets: path to the service-account JSON key, kept OUTSIDE the
# repository (e.g. ~/.config/ltd/sheets-sa.json, chmod 600). Share the
# spreadsheet with the service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=
# The ID from https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Worksheet (tab) whose row 1 is the exact header (see docs/integrations.md).
GOOGLE_SHEETS_WORKSHEET=Projects
# Live check only: a separate TEST spreadsheet (never the reporting one).
# Run with GOOGLE_SHEETS_LIVE_TEST=1 in the shell.
GOOGLE_SHEETS_TEST_SPREADSHEET_ID=
GOOGLE_SHEETS_TEST_WORKSHEET=
# Slack incoming webhook for the team channel (a SECRET: the URL is the
# credential). Must be https://hooks.slack.com/services/T…/B…/… exactly.
SLACK_WEBHOOK_URL=
# Live check only (python -m app.integrations.slack_live_check): set
# SLACK_LIVE_TEST=1 in the shell to allow one real post to a sandbox channel.

# Reliability tuning
HTTP_TIMEOUT_SECONDS=15
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=5
# Worker lease per claimed job (seconds); must exceed HTTP_TIMEOUT_SECONDS.
WORKER_LEASE_SECONDS=120
# Upper bound for retry backoff and Retry-After (seconds).
WORKER_MAX_RETRY_DELAY_SECONDS=900
# Optional fixed worker identity; default is host:pid:random.
WORKER_ID=
